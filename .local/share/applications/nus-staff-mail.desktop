[Desktop Entry]
Name=NUS Staff Mail
Exec=google-chrome-stable --gtk-version=4 --enable-features=UseOzonePlatform --ozone-platform=wayland --enable-wayland-ime --enable-features=WaylandWindowDecorations --profile-directory=Default --app=https://outlook.com/u.nus.edu
Terminal=false
Type=Application
Icon=outlook
StartupWMClass=crx_nusmail
Comment=NUS Staff Mail
Categories=Network;Email;
