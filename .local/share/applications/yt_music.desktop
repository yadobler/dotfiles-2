[Desktop Entry]
Name=youtube-music
Exec=brave --enable-features=UseOzonePlatform --ozone-platform=wayland --enable-wayland-ime --enable-features=WaylandWindowDecorations --profile-directory=Default --app=https://music.youtube.com/
Type=Application
Icon=youtube-music
StartupWMClass=crx_whatsapp
Comment=Whatsapp Web
Categories=AudioVideo;Music;
X-Desktop-File-Install-Version=0.27
